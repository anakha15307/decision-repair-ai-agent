# Optional. Without a key the app uses the deterministic, clearly labelled demo analyzer.
# The key is read only on the server and never sent to the browser.
# ANTHROPIC_API_KEY=

# Optional model override for the live analyzer (default: claude-opus-5-5).
# DR_MODEL=claude-opus-5-5

# Force the demo analyzer even when a key is present.
# DR_ANALYZER=demo

# Optional database location (default: data/decision-repair.db).
# DR_DB_PATH=
